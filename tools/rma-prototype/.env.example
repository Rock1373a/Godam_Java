# Copy to .env and fill in real values before enabling live email.
# Prototype defaults to dry-run (prints emails to terminal).

RMA_EMAIL_DRY_RUN=1

# gmail = uses n8n credential "GAPP Gmail OAuth - Web Client" (gmail.send + gmail.modify)
# smtp  = manual SMTP below
RMA_EMAIL_BACKEND=gmail

# Optional override; blank = Gmail profile address (GAPP mailbox)
RMA_EMAIL_FROM=
RMA_SMTP_HOST=
RMA_SMTP_PORT=587
RMA_SMTP_USER=
RMA_SMTP_PASS=

# On RME create — management (Ibrahim, Deepak)
RMA_EMAIL_ON_CREATE_MGMT=ibrahim@example.com,deepak@example.com

# On RME create — warehouse team (Jaigariya, Afar)
RMA_EMAIL_ON_CREATE_TEAM=jaigariya@example.com,afar@example.com

# On received / closed — everyone (comma-separated)
RMA_EMAIL_ALL=ibrahim@example.com,deepak@example.com,jaigariya@example.com,afar@example.com
